{
  "expo": {
    "name": "BOOOMERANGS Админка",
    "slug": "admin-bmg",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "adminbmg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ru.booomerangs.admin",
      "supportsTablet": true
    },
    "android": {
      "package": "ru.booomerangs.admin",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0f"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0f"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8afeb2c4-7991-450a-96a1-1d8180866152"
      }
    }
  }
}
